{
  "name": "beeclean-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node init && npm run dev --workspace=apps/backend",
    "build:backend": "node init && npm run build --workspace=apps/backend",
    "start:backend": "node init && npm run start --workspace=apps/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "dotenv": "^8.2.0",
    "node-fetch": "^3.3.2",
    "typescript": "^6.0.3"
  }
}
